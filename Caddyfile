{$CADDY_SITE_ADDRESS::80} {
	# Strip CF-Connecting-IP si la requête ne vient pas d'un range Cloudflare :
	# empêche un client d'atteindre Caddy en direct (80/443 ouverts) et de
	# forger l'IP vue par Django. Ranges publiés : https://www.cloudflare.com/ips/
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	request_header @not_cloudflare -CF-Connecting-IP

	reverse_proxy {
		# DNS Docker ré-résolu à chaque requête : plus besoin de redémarrer
		# Caddy quand on recrée le container `app`.
		dynamic a {
			name app
			port 8000
			refresh 1s
		}
		# Cloudflare Tunnel termine TLS en amont et n'envoie pas X-Forwarded-Proto :
		# on l'indique à Django pour éviter la boucle SECURE_SSL_REDIRECT.
		header_up X-Forwarded-Proto https
		# Rejoue brièvement la requête si l'upstream hoquette.
		lb_try_duration 5s
		lb_try_interval 250ms
	}
}
