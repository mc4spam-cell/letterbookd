DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# En prod, pointer un vrai domaine pour que Caddy obtienne un certificat TLS :
# CADDY_SITE_ADDRESS=letterbookd.example.org
CADDY_SITE_ADDRESS=:80
DATABASE_URL=postgres://letterbookd:letterbookd@db:5432/letterbookd
POSTGRES_DB=letterbookd
POSTGRES_USER=letterbookd
POSTGRES_PASSWORD=letterbookd
